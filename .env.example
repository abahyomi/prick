# ── Supabase (RECOMENDADO — sincronización entre dispositivos) ──
# 1. Crea un proyecto gratis en https://supabase.com
# 2. En SQL Editor ejecuta el schema de abajo
# 3. Crea un bucket llamado "prick-photos" en Storage (público)
# 4. Añade estas variables en Vercel → Settings → Environment Variables

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_BUCKET=prick-photos

# ── Cloudinary (alternativa solo para imágenes, sin base de datos) ──
# VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=tu_preset_sin_firma

# ────────────────────────────────────────────────────────────────────
# SQL para ejecutar en Supabase → SQL Editor:
#
# create table photos (
#   id          text primary key,
#   url         text not null,
#   thumb       text,
#   date        text,
#   location    text,
#   description text,
#   author      text,
#   camera      text,
#   iso         text,
#   aperture    text,
#   shutter     text,
#   created_at  timestamptz default now()
# );
#
# alter table photos enable row level security;
# create policy "acceso_publico" on photos for all using (true) with check (true);
# ────────────────────────────────────────────────────────────────────
